{
  "expo": {
    "name": "Aurora",
    "slug": "aurora-app",
    "scheme": "aurora",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": true },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.aurora.app" },
    "android": { "package": "com.aurora.app" },
    "web": { "bundler": "metro", "output": "single" }
  }
}
