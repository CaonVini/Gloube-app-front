# Copie para .env  (docker compose lê este arquivo automaticamente)

# IP do computador na rede local (necessário para abrir no celular via Expo Go).
# Linux: `hostname -I`; macOS: `ipconfig getifaddr en0`; Windows: `ipconfig`.
HOST_IP=

# URL da API de backend, como o APP a enxerga:
#  - Navegador / emulador iOS:  http://localhost:3333
#  - Emulador Android:          http://localhost:3333  (o app troca para 10.0.2.2 sozinho)
#  - Celular físico:            http://SEU_HOST_IP:3333
EXPO_PUBLIC_API_URL=http://localhost:3333

# Login social (opcional — botões ficam desabilitados se vazio). Valores PÚBLICOS; nunca coloque segredos aqui.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
